PORT=3000
NODE_ENV=development

# Required in production: a long random value used to sign sign-in sessions (at least 32 characters).
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
APP_URL=https://your-club.vercel.app
# How long a sign-in lasts, in hours (default 8)
SESSION_HOURS=8
