# Local MongoDB (default in development if unset):
MONGODB_URI=mongodb://127.0.0.1:27017/clubpoint
MONGODB_URI=mongodb+srv://anitagloria233_db_user:1f2ASu4UqQ3MteHG@clubpoints.mayxpon.mongodb.net/
# MongoDB Atlas example (use a least-privilege database user):
